APP_ENV=development

# Use SQLite for zero-setup local dev:
DATABASE_URL=sqlite+aiosqlite:///./nutriai.db
# Or use Postgres (matches docker-compose):
# DATABASE_URL=postgresql+asyncpg://nutriai:nutriai@localhost:5432/nutriai

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional - Microsoft Entra ID. Leave empty to use guest-mode only.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Optional - Azure Blob Storage. Falls back to local ./uploads if empty.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=meal-images

# ---- AI provider ----
# mock   = built-in Indian-meal mock (no network, no token)
# github = real vision via GitHub Models (set GITHUB_TOKEN below)
AI_PROVIDER=mock

# GitHub Models — required when AI_PROVIDER=github.
# Create a fine-grained or classic PAT with the "models:read" scope:
#   https://github.com/settings/tokens
GITHUB_TOKEN=
AI_VISION_MODEL=gpt-4o
AI_VISION_ENDPOINT=https://models.github.ai/inference

# USDA FoodData Central — real nutrition fallback for any food not in the
# local Indian table. Free key (1000 req/h) at:
#   https://fdc.nal.usda.gov/api-key-signup
# Leave empty to skip USDA — only the local table will be used.
USDA_API_KEY=
